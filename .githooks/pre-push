#!/usr/bin/env bash
set -Eeuo pipefail
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo 'ERRO: push direto para main bloqueado. Use develop -> PR -> main.' >&2
      exit 1
      ;;
    refs/heads/develop)
      if [[ "${ZOOQUEST_RECONCILIATION_BOOTSTRAP:-0}" == '1' ]]; then
        echo 'ZOOQUEST_LOCAL_HOOK_BOOTSTRAP=ALLOW_DEVELOP_REPAIR' >&2
        continue
      fi
      echo 'ERRO: push direto para develop bloqueado. Use branch de trabalho -> PR -> develop.' >&2
      exit 1
      ;;
  esac
done
